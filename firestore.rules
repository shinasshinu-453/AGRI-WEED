rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Detections collection
    match /detections/{detectionId} {
      // Allow authenticated users to read their own detections
      // Allow admins to read all detections
      allow read: if isAuthenticated() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Allow authenticated users to create detections
      allow create: if isAuthenticated() && 
                       request.resource.data.userId == request.auth.uid;
      
      // Allow users to update their own detections
      // Allow admins to update all detections
      allow update: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
      
      // Allow users to delete their own detections
      // Allow admins to delete all detections
      allow delete: if isAuthenticated() && 
                       (resource.data.userId == request.auth.uid || isAdmin());
    }
    
    // Users collection
    match /users/{userId} {
      // Allow users to read their own profile
      // Allow admins to read all users
      allow read: if isAuthenticated() && 
                     (userId == request.auth.uid || isAdmin());
      
      // Allow users to create their own profile during signup
      allow create: if isAuthenticated() && userId == request.auth.uid;
      
      // Allow users to update their own profile
      // Allow admins to update all users
      allow update: if isAuthenticated() && 
                       (userId == request.auth.uid || isAdmin());
      
      // Only admins can delete users
      allow delete: if isAdmin();
    }
    
    // Activities collection
    match /activities/{activityId} {
      // Allow authenticated users to read activities
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create activities
      allow create: if isAuthenticated();
      
      // Only admins can update/delete activities
      allow update, delete: if isAdmin();
    }
    
    // Weather data cache (from your ETL pipeline)
    match /weather/{weatherId} {
      // Allow all authenticated users to read weather data
      allow read: if isAuthenticated();
      
      // Only allow server/functions to write weather data
      // In development, you might want to allow admins to write
      allow write: if isAdmin();
    }
    
    // Crop recommendations
    match /recommendations/{recommendationId} {
      // Allow authenticated users to read recommendations
      allow read: if isAuthenticated();
      
      // Allow authenticated users to create recommendations
      allow create: if isAuthenticated();
      
      // Allow users to update/delete their own recommendations
      allow update, delete: if isAuthenticated() && 
                               (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
